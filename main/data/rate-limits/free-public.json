{
  "schemaVersion": "1.0",
  "tier": "free-public",
  "label": "Free",
  "lastVerified": "2026-06-12",
  "apis": [
    {
      "name": "Authentication API",
      "globalLimits": [
        { "environment": "production", "burstRps": 300, "sustainedRps": 5 },
        { "environment": "non-production", "burstRps": 300, "sustainedRps": 5 }
      ],
      "endpointPolicies": [
        {
          "policyId": "auth-userinfo",
          "name": "User Info",
          "paths": ["/userinfo"],
          "methods": ["GET", "POST"],
          "burstLimit": 10,
          "sustainedLimit": 5,
          "sustainedWindow": "minute",
          "limitKey": "user_id",
          "docsLink": "https://auth0.com/docs/api/authentication#get-user-info"
        },
        {
          "policyId": "auth-change-password",
          "name": "Change Password / Reset Password",
          "paths": ["/dbconnections/change_password", "/u/reset-password/request/:connection"],
          "methods": ["POST"],
          "burstLimit": 10,
          "sustainedLimit": 1,
          "sustainedWindow": "minute",
          "limitKey": "email",
          "docsLink": "https://auth0.com/docs/api/authentication#change-password"
        },
        {
          "policyId": "auth-passwordless-start",
          "name": "Get Passwordless Code or Link",
          "paths": ["/passwordless/start"],
          "methods": ["GET", "POST"],
          "burstLimit": 50,
          "sustainedLimit": 50,
          "sustainedWindow": "hour",
          "limitKey": "ip",
          "docsLink": "https://auth0.com/docs/api/authentication#passwordless"
        },
        {
          "policyId": "auth-oauth-token",
          "name": "Get Token",
          "paths": ["/oauth/token"],
          "methods": ["POST"],
          "burstLimit": 30,
          "sustainedLimit": 30,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "auth-co-authenticate",
          "name": "Cross-Origin Authentication",
          "paths": ["/co/authenticate"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "auth-usernamepassword-login",
          "name": "Username/Password Authentication",
          "paths": ["/usernamepassword/login"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "auth-jwks",
          "name": "JSON Web Token Keys",
          "paths": ["/.well-known/jwks.json"],
          "methods": ["GET"],
          "burstLimit": 20,
          "sustainedLimit": 20,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "auth-native-social",
          "name": "Native Social Login (Apple / Facebook)",
          "paths": ["/oauth/token"],
          "methods": ["POST"],
          "burstLimit": 50,
          "sustainedLimit": 50,
          "sustainedWindow": "minute",
          "limitKey": "any",
          "notes": "Only applies to Apple or Facebook Native Social Login requests"
        },
        {
          "policyId": "auth-dcr",
          "name": "Dynamic Application (Client) Registration",
          "paths": ["/oidc/register"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any",
          "docsLink": "https://auth0.com/docs/api/authentication#dynamic-application-client-registration"
        },
        {
          "policyId": "auth-obo-token-exchange",
          "name": "On-Behalf-Of Token Exchange",
          "paths": ["/oauth/token"],
          "methods": ["POST"],
          "burstLimit": 2,
          "sustainedLimit": 2,
          "sustainedWindow": "second",
          "limitKey": "any",
          "docsLink": "https://auth0.com/docs/secure/call-apis-on-users-behalf/on-behalf-of-token-exchange"
        }
      ]
    },
    {
      "name": "Management API",
      "globalLimits": [
        { "environment": "production", "burstRps": 2, "sustainedRps": 2 },
        { "environment": "non-production", "burstRps": 2, "sustainedRps": 2 }
      ],
      "endpointPolicies": [
        {
          "policyId": "mgmt-dcr",
          "name": "Register Dynamic Client",
          "paths": ["/oidc/register"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-custom-domain-verify",
          "name": "Verify Custom Domain",
          "paths": ["/api/v2/custom-domains/{id}/verify"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "minute",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-connection-status",
          "name": "Read Status Connection",
          "paths": ["/api/v2/connections/{id}/status"],
          "methods": ["GET"],
          "burstLimit": 100,
          "sustainedLimit": 15,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-signing-keys-rotate",
          "name": "Rotate Signing Keys",
          "paths": ["/api/v2/keys/signing/rotate"],
          "methods": ["POST"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "day",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-email-templates-write",
          "name": "Write Email Templates",
          "paths": ["/api/v2/email-templates"],
          "methods": ["POST", "PATCH", "DELETE"],
          "burstLimit": 5,
          "sustainedLimit": 25,
          "sustainedWindow": "minute",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-email-templates-read",
          "name": "Read Email Templates",
          "paths": ["/api/v2/email-templates"],
          "methods": ["GET"],
          "burstLimit": 10,
          "sustainedLimit": 50,
          "sustainedWindow": "minute",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-email-provider-write",
          "name": "Write Email Provider",
          "paths": ["/api/v2/emails/provider"],
          "methods": ["POST", "PATCH", "DELETE"],
          "burstLimit": 5,
          "sustainedLimit": 25,
          "sustainedWindow": "minute",
          "limitKey": "any"
        },
        {
          "policyId": "mgmt-email-provider-read",
          "name": "Read Email Provider",
          "paths": ["/api/v2/emails/provider"],
          "methods": ["GET"],
          "burstLimit": 5,
          "sustainedLimit": 25,
          "sustainedWindow": "minute",
          "limitKey": "any"
        }
      ]
    },
    {
      "name": "My Account API",
      "globalLimits": [],
      "endpointPolicies": [
        {
          "policyId": "myaccount-read-authmethods-tenant",
          "name": "Read Authentication Methods (tenant level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["GET"],
          "burstLimit": 2,
          "sustainedLimit": 2,
          "sustainedWindow": "second",
          "limitKey": "any",
          "notes": "Tenant-level limit"
        },
        {
          "policyId": "myaccount-write-authmethods-tenant",
          "name": "Write Authentication Methods (tenant level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["POST", "PUT", "DELETE"],
          "burstLimit": 2,
          "sustainedLimit": 2,
          "sustainedWindow": "second",
          "limitKey": "any",
          "notes": "Tenant-level limit"
        },
        {
          "policyId": "myaccount-read-authmethods-filtered-tenant",
          "name": "Read Authentication Methods filtered (tenant level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["GET"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any",
          "notes": "Tenant-level limit, filtered requests"
        },
        {
          "policyId": "myaccount-read-authmethods-user",
          "name": "Read Authentication Methods (user level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["GET"],
          "burstLimit": 2,
          "sustainedLimit": 2,
          "sustainedWindow": "minute",
          "limitKey": "user_id",
          "notes": "User-level limit"
        },
        {
          "policyId": "myaccount-write-authmethods-user",
          "name": "Write Authentication Methods (user level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["POST", "PUT", "DELETE"],
          "burstLimit": 2,
          "sustainedLimit": 2,
          "sustainedWindow": "minute",
          "limitKey": "user_id",
          "notes": "User-level limit"
        },
        {
          "policyId": "myaccount-read-authmethods-filtered-user",
          "name": "Read Authentication Methods filtered (user level)",
          "paths": ["/api/v2/users/{id}/authentication-methods"],
          "methods": ["GET"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "minute",
          "limitKey": "user_id",
          "notes": "User-level limit, filtered requests"
        }
      ]
    },
    {
      "name": "SCIM API",
      "globalLimits": [],
      "endpointPolicies": [
        {
          "policyId": "scim-connection-single",
          "name": "Single SCIM connection endpoint",
          "paths": ["/scim/v2/connections/{connection-id}"],
          "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any"
        },
        {
          "policyId": "scim-connection-global",
          "name": "Global tenant limit (all SCIM connections)",
          "paths": ["/scim/v2/connections/*"],
          "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
          "burstLimit": 5,
          "sustainedLimit": 5,
          "sustainedWindow": "second",
          "limitKey": "any"
        }
      ]
    }
  ]
}
